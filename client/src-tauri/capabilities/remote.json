{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote",
  "description": "Capability for the remote Web SPA (served by the configured Server) loaded in the web child window",
  "windows": [
    "web"
  ],
  "remote": {
    "urls": [
      "http://*:*",
      "https://*:*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-do-login",
    "allow-do-register",
    "allow-do-logout",
    "allow-get-access-token",
    "allow-refresh-access-token",
    "allow-get-user-id",
    "allow-get-user-info",
    "allow-open-url"
  ]
}
