{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "window-state:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    },
    "allow-set-server-url",
    "allow-get-server-url",
    "allow-test-connection",
    "allow-open-web",
    "allow-auto-login",
    "allow-do-logout",
    "allow-get-user-info"
  ]
}
